generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  telegramId       BigInt   @unique
  telegramData     Json
  firstName        String?
  lastName         String?
  username         String?
  photoUrl         String?
  languageCode     String?
  activeProfileId  Int?     @unique
  activeProfile    Profile? @relation("UserActiveProfile", fields: [activeProfileId], references: [id])
  profiles         Profile[] @relation("UserProfiles")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Profile {
  id               Int      @id @default(autoincrement())
  type             String   // 'parent' | 'specialist' | 'shop'
  userId           Int
  user             User     @relation("UserProfiles", fields: [userId], references: [id])
  name             String?
  photoUrl         String?
  
  // Общие поля для всех профилей
  city             String?
  district         String?
  description      String?
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  isVerified       Boolean  @default(false)
  isPromoted       Boolean  @default(false)
  
  // Поля для родителя
  childrenAgeMin   Int?
  childrenAgeMax   Int?
  specialWishes    String?
  
  // Поля для специалиста
  skills           String[]
  experienceYears  Int?
  ageGroups        String[]
  pricePerHour     Decimal? @db.Decimal(10, 2)
  portfolioPhotos  String[]
  workingDistricts String[]
  
  // Поля для магазина
  shopName         String?
  logoUrl          String?
  address          String?
  workingHours     String?
  contacts         String?
  productCategories String[]
  
  // Отношения
  requests         Request[]
  applications     Application[]
  products         Product[]
  reviewsGiven     Review[] @relation("ProfileGivenReviews")
  reviewsReceived  Review[] @relation("ProfileReceivedReviews")
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Request {
  id               Int      @id @default(autoincrement())
  parentProfileId  Int
  parentProfile    Profile  @relation(fields: [parentProfileId], references: [id])
  category         String
  childAge         Int
  description      String
  dateTime         DateTime
  durationHours    Int
  budget           Decimal? @db.Decimal(10, 2)
  status           String   @default("active") // 'active', 'in_progress', 'completed', 'cancelled'
  applications     Application[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Application {
  id               Int      @id @default(autoincrement())
  requestId        Int
  request          Request  @relation(fields: [requestId], references: [id])
  specialistProfileId Int
  specialistProfile Profile @relation(fields: [specialistProfileId], references: [id])
  price            Decimal? @db.Decimal(10, 2)
  message          String?
  status           String   @default("pending") // 'pending', 'accepted', 'rejected'
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Product {
  id               Int      @id @default(autoincrement())
  shopProfileId    Int
  shopProfile      Profile  @relation(fields: [shopProfileId], references: [id])
  name             String
  description      String?
  price            Decimal  @db.Decimal(10, 2)
  category         String
  images           String[]
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Review {
  id               Int      @id @default(autoincrement())
  fromProfileId    Int
  fromProfile      Profile  @relation("ProfileGivenReviews", fields: [fromProfileId], references: [id])
  toProfileId      Int
  toProfile        Profile  @relation("ProfileReceivedReviews", fields: [toProfileId], references: [id])
  requestId        Int?
  request          Request? @relation(fields: [requestId], references: [id])
  rating           Int      // 1-5
  comment          String?
  createdAt        DateTime @default(now())
}

model Advertisement {
  id               Int      @id @default(autoincrement())
  title            String
  description      String?
  imageUrl         String
  targetUrl        String?
  targetRole       String?  // 'parent', 'specialist', 'shop', или null для всех
  isActive         Boolean  @default(true)
  displayCount     Int      @default(0)
  clickCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Индексы для производительности
index ProfileUserIndex {
  userId
}

index ProfileTypeIndex {
  type
}

index RequestParentIndex {
  parentProfileId
}

index ApplicationRequestIndex {
  requestId
}

index ApplicationSpecialistIndex {
  specialistProfileId
}

index ProductShopIndex {
  shopProfileId
}

index ReviewFromIndex {
  fromProfileId
}

index ReviewToIndex {
  toProfileId
}