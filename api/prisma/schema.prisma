generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model banners {
  id         BigInt    @id @default(autoincrement())
  title      String?
  image_url  String
  target_url String?
  is_active  Boolean   @default(true)
  placements Json?
  starts_at  DateTime? @db.Timestamptz(6)
  ends_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
}

model offers {
  id                    BigInt       @id @default(autoincrement())
  request_id            BigInt
  specialist_profile_id BigInt
  price_offer           Int?
  comment               String?
  status                offer_status @default(pending)
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  updated_at            DateTime     @default(now()) @db.Timestamptz(6)
  requests              requests     @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles              profiles     @relation(fields: [specialist_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([request_id, specialist_profile_id])
  @@index([request_id], map: "idx_offers_request")
}

model parent_profiles {
  profile_id     BigInt   @id
  children_ages  Json?
  special_wishes String?
  profiles       profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model profiles {
  id              BigInt        @id @default(autoincrement())
  user_id         BigInt
  type            profile_type
  is_active       Boolean       @default(true)
  display_name    String?
  avatar_url      String?
  city            String?
  district        String?
  rating_avg      Decimal       @default(0.0) @db.Decimal(2, 1)
  rating_count    Int           @default(0)
  promoted_until  DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  
  // Relations
  user            users         @relation("UserProfiles", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  offers          offers[]
  parent_profiles parent_profiles?
  requests        requests[]
  reviews_from    reviews[]     @relation("reviews_from_profile_idToprofiles")
  reviews_to      reviews[]     @relation("reviews_to_profile_idToprofiles")
  shop_products   shop_products[]
  shop_profiles   shop_profiles?
  specialist_portfolio specialist_portfolio[]
  specialist_profiles specialist_profiles?
  users_as_active users[]       @relation("UserActiveProfile")

  @@unique([user_id, type])
  @@index([type, is_active], map: "idx_profiles_type_active")
}

model requests {
  id                BigInt         @id @default(autoincrement())
  parent_profile_id BigInt
  category          String
  child_age         Int?
  description       String?
  start_at          DateTime?      @db.Timestamptz(6)
  duration_min      Int?
  budget            Int?
  district          String?
  status            request_status @default(active)
  completed_at      DateTime?      @db.Timestamptz(6)
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @db.Timestamptz(6)
  offers            offers[]
  parent            profiles       @relation(fields: [parent_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviews           reviews[]

  @@index([status], map: "idx_requests_status")
}

model reviews {
  id               BigInt    @id @default(autoincrement())
  from_profile_id  BigInt
  to_profile_id    BigInt
  request_id       BigInt?
  rating           Int
  text             String?
  is_hidden        Boolean   @default(false)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  
  from_profile     profiles  @relation("reviews_from_profile_idToprofiles", fields: [from_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  to_profile       profiles  @relation("reviews_to_profile_idToprofiles", fields: [to_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  request          requests? @relation(fields: [request_id], references: [id], onUpdate: NoAction)

  @@index([to_profile_id], map: "idx_reviews_to_profile")
}

model shop_products {
  id          BigInt   @id @default(autoincrement())
  profile_id  BigInt
  title       String
  description String?
  price       Int?
  category    String?
  image_urls  Json?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  shop        profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model shop_profiles {
  profile_id  BigInt   @id
  shop_name   String?
  logo_url    String?
  description String?
  address     String?
  work_hours  String?
  contacts    Json?
  categories  Json?
  profile     profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model specialist_portfolio {
  id         BigInt   @id @default(autoincrement())
  profile_id BigInt
  image_url  String
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  profile    profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model specialist_profiles {
  profile_id       BigInt   @id
  skills           Json?
  experience_years Int?
  age_groups       Json?
  price_per_hour   Int?
  work_districts   Json?
  about            String?
  profile          profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id               BigInt   @id @default(autoincrement())
  telegram_id      BigInt   @unique
  first_name       String?
  last_name        String?
  username         String?
  photo_url        String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  active_profile_id BigInt?
  
  profiles        profiles[] @relation("UserProfiles")
  active_profile  profiles?  @relation("UserActiveProfile", fields: [active_profile_id], references: [id], onUpdate: NoAction)
}

enum offer_status {
  pending
  accepted
  rejected
  cancelled
}

enum profile_type {
  parent
  specialist
  shop
}

enum request_status {
  active
  in_progress
  done
  cancelled
}