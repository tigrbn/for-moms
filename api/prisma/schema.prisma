generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Banner {
  id         BigInt    @id @default(autoincrement())
  title      String?
  imageUrl   String    @map("image_url")
  targetUrl  String?   @map("target_url")
  isActive   Boolean   @default(true) @map("is_active")
  placements Json?
  startsAt   DateTime? @db.Timestamptz(6) @map("starts_at")
  endsAt     DateTime? @db.Timestamptz(6) @map("ends_at")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@map("banners")
}

model Offer {
  id                  BigInt      @id @default(autoincrement())
  requestId           BigInt      @map("request_id")
  specialistProfileId BigInt      @map("specialist_profile_id")
  priceOffer          Int?        @map("price_offer")
  comment             String?
  status              OfferStatus @default(pending)
  createdAt           DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime    @default(now()) @db.Timestamptz(6) @map("updated_at")

  request             Request     @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  specialistProfile   Profile     @relation(fields: [specialistProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requestId, specialistProfileId])
  @@index([requestId], map: "idx_offers_request")
  @@map("offers")
}

model ParentProfile {
  profileId     BigInt  @id @map("profile_id")
  childrenAges  Json?   @map("children_ages")
  specialWishes String? @map("special_wishes")
  profile       Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("parent_profiles")
}

model Profile {
  id            BigInt      @id @default(autoincrement())
  userId        BigInt      @map("user_id")
  type          ProfileType
  isActive      Boolean     @default(true) @map("is_active")
  displayName   String?     @map("display_name")
  avatarUrl     String?     @map("avatar_url")
  city          String?
  district      String?
  ratingAvg     Decimal     @default(0.0) @db.Decimal(2, 1) @map("rating_avg")
  ratingCount   Int         @default(0) @map("rating_count")
  promotedUntil DateTime?   @db.Timestamptz(6) @map("promoted_until")
  createdAt     DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime    @default(now()) @db.Timestamptz(6) @map("updated_at")

  // Relations
  user               User                @relation("UserProfiles", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  offers             Offer[]
  parentProfile      ParentProfile?
  requests           Request[]
  reviewsFrom        Review[]            @relation("ReviewsFrom")
  reviewsTo          Review[]            @relation("ReviewsTo")
  shopProducts       ShopProduct[]
  shopProfile        ShopProfile?
  specialistPortfolio SpecialistPortfolio[]
  specialistProfile  SpecialistProfile?
  usersAsActive      User[]              @relation("UserActiveProfile")

  @@unique([userId, type])
  @@index([type, isActive], map: "idx_profiles_type_active")
  @@map("profiles")
}

model Request {
  id              BigInt        @id @default(autoincrement())
  parentProfileId BigInt        @map("parent_profile_id")
  category        String
  childAge        Int?          @map("child_age")
  description     String?
  startAt         DateTime?     @db.Timestamptz(6) @map("start_at")
  durationMin     Int?          @map("duration_min")
  budget          Int?
  district        String?
  status          RequestStatus @default(active)
  completedAt     DateTime?     @db.Timestamptz(6) @map("completed_at")
  createdAt       DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime      @default(now()) @db.Timestamptz(6) @map("updated_at")

  offers          Offer[]
  parent          Profile       @relation(fields: [parentProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviews         Review[]

  @@index([status], map: "idx_requests_status")
  @@map("requests")
}

model Review {
  id            BigInt   @id @default(autoincrement())
  fromProfileId BigInt   @map("from_profile_id")
  toProfileId   BigInt   @map("to_profile_id")
  requestId     BigInt?  @map("request_id")
  rating        Int
  text          String?
  isHidden      Boolean  @default(false) @map("is_hidden")
  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  fromProfile   Profile  @relation("ReviewsFrom", fields: [fromProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  toProfile     Profile  @relation("ReviewsTo", fields: [toProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  request       Request? @relation(fields: [requestId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([toProfileId], map: "idx_reviews_to_profile")
  @@map("reviews")
}

model ShopProduct {
  id          BigInt   @id @default(autoincrement())
  profileId   BigInt   @map("profile_id")
  title       String
  description String?
  price       Int?
  category    String?
  imageUrls   Json?    @map("image_urls")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime @default(now()) @db.Timestamptz(6) @map("updated_at")

  shop        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("shop_products")
}

model ShopProfile {
  profileId   BigInt  @id @map("profile_id")
  shopName    String? @map("shop_name")
  logoUrl     String? @map("logo_url")
  description String?
  address     String?
  workHours   String? @map("work_hours")
  contacts    Json?
  categories  Json?

  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("shop_profiles")
}

model SpecialistPortfolio {
  id        BigInt   @id @default(autoincrement())
  profileId BigInt   @map("profile_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("specialist_portfolio")
}

model SpecialistProfile {
  profileId       BigInt @id @map("profile_id")
  skills          Json?
  experienceYears Int?   @map("experience_years")
  ageGroups       Json?  @map("age_groups")
  pricePerHour    Int?   @map("price_per_hour")
  workDistricts   Json?  @map("work_districts")
  about           String?

  profile         Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("specialist_profiles")
}

model User {
  id              BigInt   @id @default(autoincrement())
  telegramId      BigInt   @unique @map("telegram_id")
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  username        String?
  photoUrl        String?  @map("photo_url")
  createdAt       DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime @default(now()) @db.Timestamptz(6) @map("updated_at")
  activeProfileId BigInt?  @map("active_profile_id")

  profiles        Profile[] @relation("UserProfiles")
  activeProfile   Profile?  @relation("UserActiveProfile", fields: [activeProfileId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("users")
}

enum OfferStatus {
  pending
  accepted
  rejected
  cancelled
}

enum ProfileType {
  parent
  specialist
  shop
}

enum RequestStatus {
  active
  in_progress
  done
  cancelled
}